{
  "roots": [
    {
      "path": "../skills",
      "namespace": "demo",
      "trusted": true
    }
  ],
  "policy": {
    "mode": "ask"
  },
  "capabilities": [
    "filesystem.read",
    "filesystem.write"
  ],
  "execution": {
    "enabled": true,
    "allowlist": [
      "demo:csv-inspector",
      "demo:markdown-report"
    ],
    "trustedSkillIds": [
      "demo:csv-inspector",
      "demo:markdown-report"
    ],
    "runDir": "../runs"
  },
  "materials": {
    "allowRoots": [
      ".."
    ]
  },
  "mcp": {
    "allowExecution": false
  },
  "selector": {
    "mode": "http",
    "baseURL": "http://127.0.0.1:11434/v1",
    "model": "YOUR_MODEL_ID",
    "apiKeyEnv": "SKILL_CONDUCTOR_API_KEY",
    "timeoutMs": 60000
  }
}
